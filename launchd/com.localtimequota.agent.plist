<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.localtimequota.agent</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/libexec/localtimequota-agent</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <!-- Only start in Aqua (GUI login) sessions, not SSH or background sessions -->
  <key>LimitLoadToSessionType</key>
  <array>
    <string>Aqua</string>
  </array>

  <!-- Run as a UI element (no Dock icon, lower priority) -->
  <key>LSUIElement</key>
  <true/>

  <!-- Standard output and error logging -->
  <key>StandardOutPath</key>
  <string>/Library/Logs/LocalTimeQuota/agent.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Library/Logs/LocalTimeQuota/agent.err.log</string>

  <!-- Allow the agent to run continuously without being terminated for inactivity -->
  <key>ProcessType</key>
  <string>Background</string>

  <!-- Ensure the agent has access to IOKit for idle time detection -->
  <!-- No TCC permissions needed for IOHIDSystem access -->
  <key>EnableTransactions</key>
  <false/>
</dict>
</plist>
